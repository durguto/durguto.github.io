---
import { readAll } from "../lib/markdoc/read";
import { blog } from "../lib/markdoc/frontmatter.schema";
import PageMeta from "../components/PageMeta.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Intro from "../components/Intro.astro";
import SineDivider from "../components/SineDivider.astro";
import { SITE_TITLE } from "../config";

const posts = await readAll({
  directory: "blog",
  frontmatterSchema: blog,
});

const sortedPosts = posts
  .filter((p) => p.frontmatter.draft !== true)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf()
  );

const postsByYear = sortedPosts.reduce(
  (acc, post) => {
    const year = post.frontmatter.date.getUTCFullYear();
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof sortedPosts>
);

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<PageLayout current="home">
  <PageMeta title={`${SITE_TITLE}`} slot="meta" />
  <Fragment slot="main">
    <Intro />

    {
      years.map((year, yearIndex) => (
        <section class={yearIndex === 0 ? "year-section gap-lg" : "year-section"}>
          <div class="year-head">
            <span class="year-label">{year}</span>
            <SineDivider class="year-wave" />
          </div>
          <div class="post-list">
            {postsByYear[year].map((post) => {
              const d = post.frontmatter.date;
              const formattedDate = `${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(d.getUTCDate()).padStart(2, "0")}`;
              return (
                <div class="post-row">
                  {post.frontmatter.external ? (
                    <a
                      href={post.frontmatter.url}
                      target="_blank"
                      rel="noreferrer"
                      class="ext"
                    >
                      {post.frontmatter.title}
                      <svg
                        aria-hidden="true"
                        fill="none"
                        height="12"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="12"
                      >
                        <path d="M7 7h10v10" />
                        <path d="M7 17 17 7" />
                      </svg>
                    </a>
                  ) : (
                    <a href={`/blog/${post.slug}`}>{post.frontmatter.title}</a>
                  )}
                  <time datetime={post.frontmatter.date.toISOString()}>
                    {formattedDate}
                  </time>
                </div>
              );
            })}
          </div>
        </section>
      ))
    }
  </Fragment>
</PageLayout>

<style>
  .year-section {
    margin-top: 48px;
  }

  .year-section.gap-lg {
    margin-top: calc(4.5 * var(--page-paragraph));
  }

  .year-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }

  .year-label {
    flex-shrink: 0;
    margin: 0;
    color: var(--text);
    font-size: 1em;
    font-weight: 500;
    line-height: 1;
    letter-spacing: inherit;
  }

  .year-wave {
    flex: 1;
    min-width: 0;
    height: 10px;
  }

  .year-section .post-list {
    margin-top: 0;
    gap: 11px;
  }
</style>
