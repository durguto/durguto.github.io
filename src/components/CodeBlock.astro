---
import { Prism } from "@astrojs/prism";

const { language, content } = Astro.props;
---

<div class="code-wrap">
    <Prism lang={language} code={content} />
    <button class="copy-btn" aria-label="Copy code">[ copy ]</button>
</div>

<script>
    document.querySelectorAll<HTMLDivElement>(".code-wrap").forEach((wrap) => {
        const btn = wrap.querySelector<HTMLButtonElement>(".copy-btn");
        const pre = wrap.querySelector("pre");

        btn?.addEventListener("click", async () => {
            const text = pre?.textContent ?? "";
            try {
                await navigator.clipboard.writeText(text);
                if (btn) btn.textContent = "[ done ]";
            } catch {
                if (btn) btn.textContent = "[ err  ]";
            }
            setTimeout(() => {
                if (btn) btn.textContent = "[ copy ]";
            }, 1500);
        });
    });
</script>

<style is:global>
    .code-wrap {
        position: relative;
    }

    .copy-btn {
        position: absolute;
        top: 0.5em;
        right: 0.5em;
        display: none;
        font-size: 1rem;
        font-family: 'Ioskeley Mono', ui-monospace, monospace;
        color: rgb(var(--color-text-muted));
        background: rgb(var(--color-bg-code));
        border: 1px solid rgb(var(--color-border-code));
        padding: 0.15em 0.5em;
        cursor: pointer;
        line-height: 1.5;
        transition: color 0.15s ease;
    }

    .copy-btn:hover {
        color: rgb(var(--color-text-heading));
    }

    .code-wrap:hover .copy-btn {
        display: block;
    }
    code[class*="language-"],
    pre[class*="language-"] {
        background: none;
        font-family: 'Ioskeley Mono', ui-monospace, Consolas, Monaco, monospace;
        font-size: 12px;
        text-align: left;
        white-space: pre;
        word-spacing: normal;
        word-break: normal;
        word-wrap: normal;
        line-height: 1.65;
        -moz-tab-size: 4;
        -o-tab-size: 4;
        tab-size: 4;
        -webkit-hyphens: none;
        -moz-hyphens: none;
        -ms-hyphens: none;
        hyphens: none;
        font-feature-settings: "calt" 1, "zero" 1;
    }

    pre[class*="language-"] {
        padding: 1em;
        margin: 0.5em 0;
        overflow: auto;
        border-radius: 0;
        border: 1px solid rgb(var(--color-border-code));
        background: rgb(var(--color-bg-code)) !important;
    }

    :not(pre) > code[class*="language-"],
    pre[class*="language-"] {
        background: rgb(var(--color-bg-code));
    }

    :not(pre) > code[class*="language-"] {
        padding: 0.1em 0.3em;
        border-radius: 0;
        white-space: normal;
    }

    pre[class*="language-"]::selection,
    pre[class*="language-"] ::selection,
    code[class*="language-"]::selection,
    code[class*="language-"] ::selection {
        background: rgb(var(--color-bg-selection) / 0.3);
    }

    /* ── Light mode syntax (dark text on warm light bg) ── */
    :not(.dark) code[class*="language-"] { color: #3a3733; }

    :not(.dark) .token.comment,
    :not(.dark) .token.prolog,
    :not(.dark) .token.doctype,
    :not(.dark) .token.cdata        { color: #b8b4ae; font-style: italic; }

    :not(.dark) .token.punctuation  { color: #8a8783; }

    :not(.dark) .token.property,
    :not(.dark) .token.tag,
    :not(.dark) .token.boolean,
    :not(.dark) .token.number,
    :not(.dark) .token.constant,
    :not(.dark) .token.attr-name    { color: #4a4743; }

    :not(.dark) .token.string,
    :not(.dark) .token.char,
    :not(.dark) .token.builtin,
    :not(.dark) .token.attr-value,
    :not(.dark) .token.inserted     { color: #5a5753; }

    :not(.dark) .token.operator,
    :not(.dark) .token.entity       { color: #7a7773; }

    :not(.dark) .token.atrule,
    :not(.dark) .token.keyword      { color: #0a0806; font-weight: 600; }

    :not(.dark) .token.function,
    :not(.dark) .token.class-name   { color: #1a1816; font-weight: 500; }

    :not(.dark) .token.property-access,
    :not(.dark) .token.variable     { color: #2a2723; }

    :not(.dark) .token.deleted,
    :not(.dark) .token.important    { color: #5a5753; }

    /* ── Dark mode syntax (light text on warm dark bg) ── */
    .dark code[class*="language-"]  { color: #b8b5b0; }

    .dark .token.comment,
    .dark .token.prolog,
    .dark .token.doctype,
    .dark .token.cdata              { color: #585550; font-style: italic; }

    .dark .token.punctuation        { color: #807d78; }

    .dark .token.property,
    .dark .token.tag,
    .dark .token.boolean,
    .dark .token.number,
    .dark .token.constant,
    .dark .token.attr-name          { color: #a8a5a0; }

    .dark .token.string,
    .dark .token.char,
    .dark .token.builtin,
    .dark .token.attr-value,
    .dark .token.inserted           { color: #b0ada8; }

    .dark .token.operator,
    .dark .token.entity             { color: #888580; }

    .dark .token.atrule,
    .dark .token.keyword            { color: #f0ede8; font-weight: 600; }

    .dark .token.function,
    .dark .token.class-name         { color: #e0ddd8; font-weight: 500; }

    .dark .token.property-access,
    .dark .token.variable           { color: #d0cdc8; }

    .dark .token.deleted,
    .dark .token.important          { color: #a8a5a0; }

    /* shared */
    .token.important,
    .token.bold     { font-weight: 600; }
    .token.italic   { font-style: italic; }
    .token.entity   { cursor: help; }
</style>
