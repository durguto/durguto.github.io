---

<aside id="toc-sidebar" class="sticky top-10 flex flex-col gap-4 pl-8">
    <p class="text-base text-text-muted">// contents</p>
    <nav id="toc-nav" class="toc-nav w-full">
    </nav>
</aside>

<script>
    function buildToc() {
        const article = document.querySelector(".blog-post");
        const nav = document.getElementById("toc-nav");
        const sidebar = document.getElementById("toc-sidebar");
        if (!article || !nav || !sidebar) return;

        const headings = [...article.querySelectorAll("h2, h3")] as HTMLElement[];
        if (headings.length === 0) {
            sidebar.style.display = "none";
            return;
        }

        headings.forEach((h) => {
            if (!h.id) {
                h.id = h.textContent
                    ?.toLowerCase()
                    .replace(/\s+/g, "-")
                    .replace(/[^a-z0-9-]/g, "") ?? "";
            }
        });

        headings.forEach((h) => {
            const a = document.createElement("a");
            a.href = `#${h.id}`;
            const linkEl = h.querySelector("a");
            a.textContent = (linkEl?.textContent ?? h.textContent ?? "").trim();
            a.dataset.id = h.id;
            a.className = [
                "toc-link",
                "unset",
                "block",
                h.tagName === "H3" ? "toc-sub" : "",
            ].filter(Boolean).join(" ");
            nav.appendChild(a);
        });

        const links = [...nav.querySelectorAll(".toc-link")] as HTMLAnchorElement[];

        function updateActive() {
            const scrollY = window.scrollY;
            const offset = 80; // px from top to consider "passed"
            let active = headings[0];

            for (const h of headings) {
                if (h.getBoundingClientRect().top + scrollY <= scrollY + offset) {
                    active = h;
                } else {
                    break;
                }
            }

            links.forEach((l) => l.classList.remove("show"));
            nav.querySelector(`[data-id="${active?.id}"]`)?.classList.add("show");
        }

        window.addEventListener("scroll", updateActive, { passive: true });
        updateActive();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", buildToc);
    } else {
        buildToc();
    }
</script>

<style is:global>
    .toc-nav {
        display: flex;
        flex-direction: column;
    }

    .toc-link {
        position: relative;
        display: block;
        padding: 0.2em 0.5em 0.2em 1.5em;
        font-size: 1rem;
        color: rgb(var(--color-text-muted));
        text-decoration: none !important;
        transition: color 0.15s ease;
        line-height: 1.6;
    }

    /* h3 indent */
    .toc-link.toc-sub {
        padding-left: 2.5em;
    }

    /* | character on the left */
    .toc-link::before {
        content: '|';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        color: rgb(var(--color-border-subtle));
        font-size: 1em;
        line-height: 1;
        transition: color 0.15s ease;
    }

    .toc-link.toc-sub::before {
        left: 1em;
    }

    /* hover: | → > */
    .toc-link:hover {
        color: rgb(var(--color-text-heading));
        opacity: 1;
        text-decoration: none !important;
    }

    .toc-link:hover::before {
        content: '>';
        color: rgb(var(--color-text-muted));
    }

    /* active: | → > */
    .toc-link.show {
        color: rgb(var(--color-text-heading));
    }

    .toc-link.show::before {
        content: '>';
        color: rgb(var(--color-text-heading));
    }
</style>
