---
import DarkModeToggle from "./DarkModeToggle.astro";
import DonutDither from "./DonutDither.astro";

interface Props {
  mobileStyle?: "hero" | "nav";
}
const { mobileStyle = "nav" } = Astro.props;
const hero = mobileStyle === "hero";
---

<aside class={`
  flex
  ${hero
    ? "flex-col items-center gap-4 px-6 pt-12 pb-8"
    : "flex-row items-center justify-between gap-3 px-5 py-3 lg:flex-col lg:items-end lg:justify-start lg:gap-6 lg:px-0 lg:pr-8 lg:py-0 lg:border-0 lg:sticky lg:top-10"
  }
`}>

    <a href="/" class={`unset flex items-center gap-4 group ${hero ? "flex-col" : "flex-row lg:flex-col lg:items-end"}`} data-donut-link>
        <div class={`sidebar-donut shrink-0 ${hero ? "w-[96px] h-[96px] lg:w-[120px] lg:h-[120px]" : "w-10 h-10 lg:w-[120px] lg:h-[120px]"}`}>
            <DonutDither />
        </div>
        <div class={`flex flex-col gap-0.5 group-hover:opacity-60 transition-opacity duration-150 ${hero ? "items-center text-center" : "lg:items-end"}`}>
            <span class="text-base font-semibold text-text-heading tracking-tight">Oğuzhan Durgut</span>
            <span class="text-base text-text-muted">@durguto</span>
            {hero && <span class="text-base text-text-muted mt-1">software engineer</span>}
        </div>
    </a>

    <div class={`flex flex-row items-center gap-4 ${hero ? "" : "lg:flex-col lg:items-end lg:gap-2"}`}>
        {!hero && <p class="hidden lg:block text-base text-text-muted text-right mb-1.5">software engineer</p>}
        <a
            href="https://github.com/durguto"
            target="_blank"
            class="unset nav-btn"
        >[ github ]</a>
        <DarkModeToggle />
    </div>

</aside>

<script>
    const donuts = document.querySelectorAll<HTMLElement>(".sidebar-donut");
    window.addEventListener("scroll", () => {
        const scrolled = window.scrollY > 60;
        donuts.forEach(d => d.classList.toggle("donut-scrolled", scrolled));
    }, { passive: true });
</script>

<style is:global>
    mode-toggle {
        display: block;
        line-height: normal;
    }

    .sidebar-donut {
        transition: opacity 0.4s ease, filter 0.4s ease;
    }

    .sidebar-donut.donut-scrolled {
        opacity: 0.18;
        filter: grayscale(1);
    }

    .sidebar-donut.donut-scrolled:hover {
        opacity: 1;
        filter: grayscale(0);
    }
    .nav-btn {
        font-size: 1rem;
        color: rgb(var(--color-text-muted));
        text-decoration: none !important;
        transition: color 0.15s ease;
        display: inline-block;
        white-space: nowrap;
    }

    .nav-btn:hover {
        color: rgb(var(--color-text-heading));
    }

    /* DarkModeToggle button aynı stili alsın */
    #mode-toggle {
        font-size: 1rem;
        color: rgb(var(--color-text-muted));
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: color 0.15s ease;
        display: inline-block;
        white-space: nowrap;
    }

    #mode-toggle:hover {
        color: rgb(var(--color-text-heading));
    }
</style>
