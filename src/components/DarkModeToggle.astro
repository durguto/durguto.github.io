---

<mode-toggle>
    <button
        id="mode-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="font-mono text-[11px] text-text-muted hover:text-text-heading transition-colors duration-150 cursor-pointer"
    >
        <span id="mode-label"></span>
    </button>
</mode-toggle>

<script>
    function updateHTMLTheme(mode: "light" | "dark") {
        const themeColorMetaTag = document.head.querySelector('meta[name="theme-color"]');
        if (mode === "dark") {
            document.documentElement.classList.remove("light");
            document.documentElement.classList.add("dark");
            // @ts-ignore
            if (themeColorMetaTag) themeColorMetaTag.content = "#0a0a0a";
        } else {
            document.documentElement.classList.remove("dark");
            document.documentElement.classList.add("light");
            // @ts-ignore
            if (themeColorMetaTag) themeColorMetaTag.content = "#ffffff";
        }
    }

    function updateStorageTheme(mode: "light" | "dark") {
        sessionStorage.setItem("theme", mode);
    }

    class ModeToggle extends HTMLElement {
        constructor() {
            super();
            let currentMode: "light" | "dark" = document.documentElement.classList.contains("dark")
                ? "dark"
                : "light";

            const toggle = this.querySelector<HTMLButtonElement>("#mode-toggle");
            const label = this.querySelector<HTMLSpanElement>("#mode-label");

            const render = () => {
                if (label) label.textContent = currentMode === "dark" ? "[ light ]" : "[ dark ]";
            };

            render();

            toggle?.addEventListener("click", () => {
                const next: "light" | "dark" = currentMode === "dark" ? "light" : "dark";
                updateHTMLTheme(next);
                updateStorageTheme(next);
                currentMode = next;
                render();
            });
        }
    }

    customElements.define("mode-toggle", ModeToggle);
</script>
