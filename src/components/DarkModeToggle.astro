---
---

<button
  type="button"
  class="theme-toggle"
  id="mode-toggle"
  aria-label="Switch to dark mode"
>
  <svg
    class="icon-moon"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M13.5 9.2A5.5 5.5 0 0 1 6.8 2.5 5.6 5.6 0 1 0 13.5 9.2Z"></path>
  </svg>
  <svg
    class="icon-sun"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
    hidden
  >
    <circle cx="8" cy="8" r="3.25"></circle>
    <path d="M8 1.5v1.25M8 13.25V14.5M1.5 8h1.25M13.25 8H14.5M3.22 3.22l.88.88M11.9 11.9l.88.88M3.22 12.78l.88-.88M11.9 4.1l.88-.88"></path>
  </svg>
</button>

<script>
  type Mode = "light" | "dark";

  type ViewTransition = {
    ready: Promise<void>;
    finished: Promise<void>;
  };

  function updateHTMLTheme(mode: Mode) {
    const themeColorMetaTag = document.head.querySelector(
      'meta[name="theme-color"]'
    );
    const toggle = document.getElementById("mode-toggle");
    const moon = toggle?.querySelector<SVGElement>(".icon-moon");
    const sun = toggle?.querySelector<SVGElement>(".icon-sun");

    if (mode === "dark") {
      document.documentElement.classList.remove("light");
      document.documentElement.classList.add("dark");
      if (themeColorMetaTag) themeColorMetaTag.setAttribute("content", "#111111");
      if (toggle) toggle.setAttribute("aria-label", "Switch to light mode");
      if (moon) moon.hidden = true;
      if (sun) sun.hidden = false;
    } else {
      document.documentElement.classList.remove("dark");
      document.documentElement.classList.add("light");
      if (themeColorMetaTag) themeColorMetaTag.setAttribute("content", "#ffffff");
      if (toggle) toggle.setAttribute("aria-label", "Switch to dark mode");
      if (moon) moon.hidden = false;
      if (sun) sun.hidden = true;
    }
  }

  function updateStorageTheme(mode: Mode) {
    sessionStorage.setItem("theme", mode);
  }

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function startViewTransition(update: () => void): ViewTransition | null {
    const doc = document as Document & {
      startViewTransition?: (cb: () => void) => ViewTransition;
    };
    if (typeof doc.startViewTransition !== "function") return null;
    return doc.startViewTransition(update);
  }

  function wait(ms: number) {
    return new Promise<void>((r) => setTimeout(r, ms));
  }

  async function blurMorph(next: Mode) {
    const root = document.documentElement;
    const transition = startViewTransition(() => {
      updateHTMLTheme(next);
      updateStorageTheme(next);
    });

    if (!transition) {
      updateHTMLTheme(next);
      updateStorageTheme(next);
      return;
    }

    try {
      await transition.ready;

      const duration = 480;
      const easing = "cubic-bezier(0.33, 1, 0.68, 1)";

      const incoming = root.animate(
        [
          { filter: "blur(16px)", opacity: 0.4 },
          { filter: "blur(0px)", opacity: 1 },
        ],
        {
          duration,
          easing,
          pseudoElement: "::view-transition-new(root)",
        }
      );

      const outgoing = root.animate(
        [
          { filter: "blur(0px)", opacity: 1 },
          { filter: "blur(16px)", opacity: 0 },
        ],
        {
          duration,
          easing,
          pseudoElement: "::view-transition-old(root)",
        }
      );

      await Promise.race([
        Promise.all([
          incoming.finished.catch(() => undefined),
          outgoing.finished.catch(() => undefined),
        ]),
        transition.finished.catch(() => undefined),
        wait(duration + 140),
      ]);
    } catch {
      /* theme already applied */
    }
  }

  const toggle = document.getElementById("mode-toggle");
  let busy = false;

  updateHTMLTheme(
    document.documentElement.classList.contains("dark") ? "dark" : "light"
  );

  if (toggle) {
    toggle.onclick = () => {
      if (busy) return;

      const current: Mode = document.documentElement.classList.contains("dark")
        ? "dark"
        : "light";
      const next: Mode = current === "dark" ? "light" : "dark";

      busy = true;
      const safety = window.setTimeout(() => {
        busy = false;
      }, 1000);

      const run = prefersReducedMotion()
        ? Promise.resolve().then(() => {
            updateHTMLTheme(next);
            updateStorageTheme(next);
          })
        : blurMorph(next);

      run.finally(() => {
        window.clearTimeout(safety);
        busy = false;
      });
    };
  }
</script>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-group(root) {
    animation: none;
  }

  ::view-transition-old(root) {
    z-index: 1;
  }

  ::view-transition-new(root) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
