---
---

<canvas
    id="dither-canvas"
    style="image-rendering: pixelated;"
></canvas>
<img id="dither-src" src="/images/me.png" alt="" class="hidden" />

<script>
    const TARGET_W = 80;

    const BAYER = [
        [ 0,  8,  2, 10],
        [12,  4, 14,  6],
        [ 3, 11,  1,  9],
        [15,  7, 13,  5],
    ];
    const BAYER_N = 4;
    const BAYER_DIV = 16;

    function dither() {
        const img = document.getElementById("dither-src") as HTMLImageElement;
        const canvas = document.getElementById("dither-canvas") as HTMLCanvasElement;
        if (!img || !canvas) return;

        const ratio = img.naturalHeight / img.naturalWidth;
        const W = TARGET_W;
        const H = Math.round(W * ratio);

        canvas.width = W;
        canvas.height = H;

        const DISPLAY_W = 120;
        const DISPLAY_H = Math.round(DISPLAY_W * ratio);
        canvas.style.width = `${DISPLAY_W}px`;
        canvas.style.height = `${DISPLAY_H}px`;

        const ctx = canvas.getContext("2d")!;
        ctx.drawImage(img, 0, 0, W, H);

        const imageData = ctx.getImageData(0, 0, W, H);
        const d = imageData.data;

        // grayscale + histogram stretch
        const grays = new Float32Array(W * H);
        let lo = 255, hi = 0;

        for (let y = 0; y < H; y++) {
            for (let x = 0; x < W; x++) {
                const i = (y * W + x) * 4;
                const g = 0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2];
                grays[y * W + x] = g;
                if (g < lo) lo = g;
                if (g > hi) hi = g;
            }
        }

        const range = hi - lo || 1;

        for (let y = 0; y < H; y++) {
            for (let x = 0; x < W; x++) {
                const i = (y * W + x) * 4;
                const normalized = (grays[y * W + x] - lo) / range;
                const gamma = Math.pow(normalized, 0.75) * 255;
                const threshold = (BAYER[y % BAYER_N][x % BAYER_N] / BAYER_DIV) * 255;
                const v = gamma > threshold ? 255 : 0;
                d[i] = d[i + 1] = d[i + 2] = v;
                d[i + 3] = 255;
            }
        }

        ctx.putImageData(imageData, 0, 0);
    }

    const img = document.getElementById("dither-src") as HTMLImageElement;
    if (img?.complete) {
        dither();
    } else {
        img?.addEventListener("load", dither);
    }
</script>
