---
---

<canvas
    id="donut-canvas"
    style="image-rendering: pixelated; width: 120px; height: 120px;"
></canvas>

<script>
    const W = 80;
    const H = 80;

    const BAYER: number[][] = [
        [ 0,  8,  2, 10],
        [12,  4, 14,  6],
        [ 3, 11,  1,  9],
        [15,  7, 13,  5],
    ];

    const canvas = document.getElementById("donut-canvas") as HTMLCanvasElement;
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext("2d")!;

    let A = 1, B = 1;
    let hovered = false;
    let frameCount = 0;

    const faviconCanvas = document.createElement("canvas");
    faviconCanvas.width = 32;
    faviconCanvas.height = 32;
    const fctx = faviconCanvas.getContext("2d")!;

    function updateFavicon() {
        fctx.drawImage(canvas, 0, 0, 32, 32);
        const link = document.getElementById("favicon-dynamic") as HTMLLinkElement;
        if (link) link.href = faviconCanvas.toDataURL("image/png");
    }

    const trigger = canvas.closest("[data-donut-link]") ?? canvas;
    trigger.addEventListener("mouseenter", () => hovered = true);
    trigger.addEventListener("mouseleave", () => hovered = false);

    function frame() {
        const imageData = ctx.createImageData(W, H);
        const px = imageData.data;
        const zbuf = new Float32Array(W * H).fill(-Infinity);

        const isDark = document.documentElement.classList.contains("dark");
        const cssVar = getComputedStyle(document.documentElement)
            .getPropertyValue("--color-bg-body").trim();
        const [r, g, b] = cssVar.split(" ").map(Number);
        const bgR = r, bgG = g, bgB = b;
        const fg = isDark ? 255 : 0;

        for (let i = 0; i < px.length; i += 4) {
            px[i] = bgR; px[i + 1] = bgG; px[i + 2] = bgB;
            px[i + 3] = 255;
        }

        const cosA = Math.cos(A), sinA = Math.sin(A);
        const cosB = Math.cos(B), sinB = Math.sin(B);

        const R1 = 1;
        const R2 = 2;
        const K2 = 5;
        const K1 = (W * K2 * 3) / (8 * (R1 + R2));

        for (let theta = 0; theta < 2 * Math.PI; theta += 0.06) {
            const ct = Math.cos(theta), st = Math.sin(theta);

            for (let phi = 0; phi < 2 * Math.PI; phi += 0.02) {
                const cp = Math.cos(phi), sp = Math.sin(phi);

                const cx = R2 + R1 * ct;
                const cy = R1 * st;

                const x = cx * (cosB * cp + sinA * sinB * sp) - cy * cosA * sinB;
                const y = cx * (sinB * cp - sinA * cosB * sp) + cy * cosA * cosB;
                const z = K2 + cosA * cx * sp + cy * sinA;
                const ooz = 1 / z;

                const xp = Math.round(W / 2 + K1 * ooz * x);
                const yp = Math.round(H / 2 - K1 * ooz * y);

                if (xp < 0 || xp >= W || yp < 0 || yp >= H) continue;

                const L =
                    cp * ct * sinB -
                    cosA * ct * sp -
                    sinA * st +
                    cosB * (cosA * st - ct * sinA * sp);

                if (ooz > zbuf[yp * W + xp]) {
                    zbuf[yp * W + xp] = ooz;

                    const lum = Math.max(0, L) / Math.SQRT2;
                    const threshold = BAYER[yp % 4][xp % 4] / 16;
                    const i = (yp * W + xp) * 4;
                    if (lum > threshold) {
                        px[i] = px[i + 1] = px[i + 2] = fg;
                    } else {
                        px[i] = bgR; px[i + 1] = bgG; px[i + 2] = bgB;
                    }
                }
            }
        }

        ctx.putImageData(imageData, 0, 0);

        frameCount++;
        if (frameCount % 3 === 0) updateFavicon();

        A += hovered ? 0.12 : 0.02;
        B += hovered ? 0.05 : 0.008;
        requestAnimationFrame(frame);
    }

    frame();
</script>
