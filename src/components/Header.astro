---
import Nav from "./Nav.astro";
import DarkModeToggle from "./DarkModeToggle.astro";
---

<div class="max-w-4xl mx-auto px-6 sm:px-8 h-14 flex items-center justify-between">
    <a
        href="/"
        class="unset flex flex-col gap-0.5 hover:opacity-60 transition-opacity duration-150"
    >
        <span class="text-sm font-semibold text-text-heading">Oğuzhan Durgut</span>
        <span class="text-xs text-text-muted">@odurgut</span>
    </a>
    <div class="flex items-center gap-4">
        <nav>
            <ul class="unset flex text-xs gap-3 [&>li]:p-0">
            </ul>
        </nav>
        <DarkModeToggle />
    </div>
</div>
