---
import "../styles/global.css";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import OMark from "../components/OMark.astro";
import DarkModeToggle from "../components/DarkModeToggle.astro";
import SineDivider from "../components/SineDivider.astro";

export interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
const d = date;
const formattedDate = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(d.getUTCDate()).padStart(2, "0")}`;
---

<!DOCTYPE html>
<html class="theme-durguto" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Favicon />
    <slot name="meta" />
    <ThemeScript />
  </head>

  <body>
    <main class="app-shell" data-layout="post">
      <div class="post-shell">
        <aside class="post-mark">
          <a href="/" class="post-mark-home unset" aria-label="Home" title="Home">
            <OMark />
          </a>
        </aside>

        <div class="page-wrap">
          <div class="page-content">
            <article class="markdown">
              <header class="post-header">
                <h1 class="post-title">{title}</h1>
                <time class="post-date" datetime={date.toISOString()}>
                  {formattedDate}
                </time>
                <SineDivider class="post-wave" />
              </header>

              <div class="prose max-w-none post-body">
                <slot name="content" />
              </div>
            </article>
          </div>
        </div>
      </div>

      <div class="footer-veil" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>
      <DarkModeToggle />
    </main>
    <div
      class="read-progress"
      role="progressbar"
      aria-label="Reading progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span></span>
    </div>
  </body>
</html>

<script>
  // Mobile: the mark scrolls away, so a hairline along the top keeps the reading progress.
  const bar = document.querySelector<HTMLElement>(".read-progress");
  if (bar) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.setProperty("--p", String(p));
      bar.classList.toggle("is-on", window.scrollY > 120);
      bar.setAttribute("aria-valuenow", String(Math.round(p * 100)));
    };
    const queue = () => {
      if (!queued) (queued = true), requestAnimationFrame(update);
    };
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue, { passive: true });
    update();
  }
</script>

<style>
  .read-progress {
    display: none;
  }

  @media (max-width: 540px) {
    .read-progress {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: calc(2px + env(safe-area-inset-top, 0px));
      z-index: 5;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .read-progress.is-on {
      opacity: 1;
    }

    .read-progress span {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2px;
      background: var(--text);
      transform: scaleX(var(--p, 0));
      transform-origin: left;
      will-change: transform;
    }
  }

  .post-header {
    margin-top: 0;
    margin-bottom: calc(2.5 * var(--page-paragraph));
  }

  .post-date {
    display: block;
    margin: 6px 0 0;
    color: var(--muted);
    font-family: var(--page-font-family);
    font-size: 12px;
    line-height: var(--page-line-height);
    letter-spacing: var(--page-letter-spacing);
    font-variant-numeric: tabular-nums;
  }

  .post-title {
    margin: 0;
    color: var(--text);
    font-size: 1em;
    font-weight: 500;
    line-height: var(--page-line-height);
    letter-spacing: inherit;
  }

  .post-wave {
    margin-top: calc(1.5 * var(--page-paragraph));
  }

  .post-body {
    padding-bottom: 96px;
  }

  .post-body :global(> :first-child),
  .post-body :global(article > :first-child) {
    margin-top: 0 !important;
  }
</style>
