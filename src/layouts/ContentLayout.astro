---
import "../styles/global.css";
import GoogleFont from "./GoogleFont.astro";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import Sidebar from "../components/Sidebar.astro";
import BannerDither from "../components/BannerDither.astro";
import TableOfContents from "../components/TableOfContents.astro";

export interface Props {
    title: string;
    date: Date;
    banner?: string;
}

const { title, date, banner } = Astro.props;
const d = date;
const formattedDate = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(d.getUTCDate()).padStart(2, "0")}`;
---

<!DOCTYPE html>
<html class="theme-odurgut" lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <Favicon />
        <slot name="meta" />
        <GoogleFont />
        <ThemeScript />
    </head>

    <body>
        <!-- Mobile: sidebar as top bar -->
        <div class="lg:hidden">
            <Sidebar />
        </div>

        <!-- Desktop: 3-column grid -->
        <div class="page-grid">
            <div class="hidden lg:block">
                <Sidebar />
            </div>

            <main
                id="main"
                class="min-h-screen px-5 lg:px-10 pt-0 lg:border-l lg:border-dotted lg:border-[rgb(var(--color-border-subtle))]"
            >
                <section class={`blog-post ${banner ? "pt-0" : "pt-16"}`}>
                    {banner && <BannerDither src={banner} />}

                    <!-- Post header -->
                    <header class="mb-10 pb-6 -mx-5 lg:-mx-10 px-5 lg:px-10 border-b border-dotted border-[rgb(var(--color-border-subtle))]">
                        <div class="flex items-baseline justify-between gap-4">
                            <h1 class="not-prose m-0 text-xl font-semibold text-text-heading leading-snug tracking-tight">
                                {title}
                            </h1>
                            <time class="text-xs text-text-muted tabular-nums shrink-0">{formattedDate}</time>
                        </div>
                    </header>

                    <!-- Post content -->
                    <div class="prose max-w-none prose-newspaper post-content">
                        <slot name="content" />
                    </div>
                </section>
            </main>

            <div class="hidden lg:block">
                <TableOfContents />
            </div>
        </div>
    </body>
</html>

<style>
    .page-grid {
        display: grid;
        grid-template-columns: 1fr minmax(0, 42rem) 1fr;
        min-height: 100vh;
    }

    @media (max-width: 1023px) {
        .page-grid {
            display: block;
            max-width: 42rem;
            margin: 0 auto;
        }
    }
</style>
