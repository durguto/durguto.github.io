---
import "../styles/global.css";
import { MY_NAME } from "../config";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import Sidebar from "../components/Sidebar.astro";
import BannerDither from "../components/BannerDither.astro";
import TableOfContents from "../components/TableOfContents.astro";

export interface Props {
    title: string;
    date: Date;
    banner?: string;
}

const { title, date, banner } = Astro.props;
const d = date;
const formattedDate = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(d.getUTCDate()).padStart(2, "0")}`;
---

<!DOCTYPE html>
<html class="theme-odurgut" lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <Favicon />
        <slot name="meta" />
        <ThemeScript />
    </head>

    <body>
        <!-- Mobile: sidebar as top bar -->
        <div class="lg:hidden">
            <Sidebar />
        </div>

        <!-- Desktop: 3-column grid -->
        <div class="page-grid">
            <div class="hidden lg:block">
                <Sidebar />
            </div>

            <main
                id="main"
                class="lg:min-h-screen px-5 lg:px-8 pt-0 lg:border-l lg:border-dotted lg:border-[rgb(var(--color-border-subtle))]"
            >
                <section class="blog-post">
                    {banner && <BannerDither src={banner} />}

                    <!-- Post header -->
                    <header class="post-header mb-10">
                        <a href="/" class="unset back-link">← writing</a>
                        <div class="meta-row mt-4">
                            <span class="meta-label">DATE:</span>
                            <time class="meta-value">{formattedDate}</time>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">TITLE:</span>
                            <h1 class="not-prose m-0 meta-value font-normal">{title}</h1>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">AUTHOR:</span>
                            <span class="meta-value">{MY_NAME}</span>
                        </div>
                        <div class="meta-sep">------</div>
                    </header>

                    <!-- Post content -->
                    <div class="prose max-w-none prose-newspaper post-content">
                        <slot name="content" />
                    </div>
                </section>
            </main>

            <div class="hidden lg:block">
                <TableOfContents />
            </div>
        </div>
    </body>
</html>

<style>
    .back-link {
        font-size: 1rem;
        color: rgb(var(--color-text-muted));
        text-decoration: none;
        transition: color 0.15s ease;
        display: inline-block;
    }

    .back-link:hover {
        color: rgb(var(--color-text-heading));
    }

    .post-header {
        padding-top: 0;
    }

    .meta-row {
        display: flex;
        align-items: baseline;
        gap: 0;
        line-height: 2;
    }

    .meta-label {
        font-size: 1rem;
        color: rgb(var(--color-text-muted));
        min-width: 6em;
        flex-shrink: 0;
        letter-spacing: 0.04em;
    }

    .meta-value {
        font-size: 1rem;
        color: rgb(var(--color-text-heading));
        line-height: 2;
    }

    .meta-sep {
        font-size: 1rem;
        color: rgb(var(--color-border-subtle));
        margin-top: 1.25em;
        margin-bottom: 2em;
        letter-spacing: 0.2em;
    }

    .page-grid {
        display: grid;
        grid-template-columns: 1fr 640px 1fr;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }

    @media (max-width: 1023px) {
        .page-grid {
            display: block;
            max-width: 640px;
            margin: 0 auto;
            min-height: 0;
        }
    }
</style>
