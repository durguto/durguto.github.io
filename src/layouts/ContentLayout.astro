---
import "../styles/global.css";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import LedOMark from "../components/LedOMark.astro";
import DarkModeToggle from "../components/DarkModeToggle.astro";
import SineDivider from "../components/SineDivider.astro";

export interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
const d = date;
const formattedDate = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}-${String(d.getUTCDate()).padStart(2, "0")}`;
---

<!DOCTYPE html>
<html class="theme-durguto" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Favicon />
    <slot name="meta" />
    <ThemeScript />
  </head>

  <body>
    <main class="app-shell" data-layout="post">
      <div class="post-shell">
        <aside class="post-mark">
          <a href="/" class="post-mark-home unset" aria-label="Home" title="Home">
            <LedOMark />
          </a>
        </aside>

        <div class="page-wrap">
          <div class="page-content">
            <article class="markdown">
              <header class="post-header">
                <h1 class="post-title">{title}</h1>
                <time class="post-date" datetime={date.toISOString()}>
                  {formattedDate}
                </time>
                <SineDivider class="post-wave" />
              </header>

              <div class="prose max-w-none prose-newspaper post-body">
                <slot name="content" />
              </div>
            </article>
          </div>
        </div>
      </div>

      <div class="footer-veil" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>
      <DarkModeToggle />
    </main>
  </body>
</html>

<style>
  .post-header {
    margin-top: 0;
    margin-bottom: calc(2.5 * var(--page-paragraph));
  }

  .post-date {
    display: block;
    margin: 6px 0 0;
    color: var(--muted);
    font-family: var(--page-font-family);
    font-size: 12px;
    line-height: var(--page-line-height);
    letter-spacing: var(--page-letter-spacing);
    font-variant-numeric: tabular-nums;
  }

  .post-title {
    margin: 0;
    color: var(--text);
    font-size: 1em;
    font-weight: 500;
    line-height: var(--page-line-height);
    letter-spacing: inherit;
  }

  .post-wave {
    margin-top: calc(1.5 * var(--page-paragraph));
  }

  .post-body {
    padding-bottom: 96px;
  }

  .post-body :global(> :first-child),
  .post-body :global(article > :first-child) {
    margin-top: 0 !important;
  }
</style>
