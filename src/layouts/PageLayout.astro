---
import "../styles/global.css";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import ProfileNav from "../components/ProfileNav.astro";
import DarkModeToggle from "../components/DarkModeToggle.astro";

interface Props {
  current?: "home" | "writing";
}
const { current = "home" } = Astro.props;
---

<!DOCTYPE html>
<html class="theme-odurgut" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Favicon />
    <slot name="meta" />
    <ThemeScript />
  </head>

  <body>
    <main class="app-shell" data-layout="portfolio">
      <div class="page-wrap">
        <div class="page-content">
          <ProfileNav current={current} />
          <article class="markdown">
            <slot name="main" />
          </article>
        </div>
      </div>

      <div class="footer-veil" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span>
      </div>
      <DarkModeToggle />
    </main>
  </body>
</html>
