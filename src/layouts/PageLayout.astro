---
import "../styles/global.css";
import GoogleFont from "./GoogleFont.astro";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  heroMobile?: boolean;
}
const { heroMobile = false } = Astro.props;
---

<!DOCTYPE html>
<html class="theme-odurgut" lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <Favicon />
        <GoogleFont />
        <slot name="meta" />
        <ThemeScript />
    </head>

    <body>
        <!-- Mobile: sidebar as top bar (full width, horizontal) -->
        <div class="lg:hidden">
            <Sidebar mobileStyle={heroMobile ? "hero" : "nav"} />
        </div>

        <!-- Desktop: 3-column grid (sidebar | content | spacer) -->
        <div class="page-grid">
            <div class="hidden lg:block">
                <Sidebar />
            </div>

            <main
                id="main"
                class="min-h-screen px-5 lg:px-10 pt-0 lg:border-l lg:border-dotted lg:border-[rgb(var(--color-border-subtle))]"
            >
                <slot name="main" />
            </main>

            <div class="hidden lg:block"></div>
        </div>
    </body>
</html>

<style>
    .page-grid {
        display: grid;
        grid-template-columns: 1fr minmax(0, 42rem) 1fr;
        min-height: 100vh;
    }

    @media (max-width: 1023px) {
        .page-grid {
            display: block;
            max-width: 42rem;
            margin: 0 auto;
        }
    }
</style>
