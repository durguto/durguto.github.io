---
import "../styles/global.css";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  heroMobile?: boolean;
}
const { heroMobile = false } = Astro.props;
---

<!DOCTYPE html>
<html class="theme-odurgut" lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <Favicon />
        <slot name="meta" />
        <ThemeScript />
    </head>

    <body>
        {heroMobile ? (
            <div class="home-page">
                <Sidebar mobileStyle="hero" />
                <main id="main" class="px-6">
                    <slot name="main" />
                </main>
            </div>
        ) : (
            <>
                <div class="lg:hidden">
                    <Sidebar mobileStyle="nav" />
                </div>

                <div class="page-grid">
                    <div class="hidden lg:block">
                        <Sidebar />
                    </div>

                    <main
                        id="main"
                        class="lg:min-h-screen px-6 lg:px-8 pt-0 lg:border-l lg:border-dotted lg:border-[rgb(var(--color-border-subtle))]"
                    >
                        <slot name="main" />
                    </main>

                    <div class="hidden lg:block"></div>
                </div>
            </>
        )}
    </body>
</html>

<style>
    .home-page {
        max-width: 640px;
        margin: 0 auto;
    }

    .page-grid {
        display: grid;
        grid-template-columns: 1fr 640px 1fr;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }

    @media (max-width: 1023px) {
        .page-grid {
            display: block;
            max-width: 640px;
            margin: 0 auto;
            min-height: 0;
        }
    }
</style>
